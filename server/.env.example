PORT=5000
NODE_ENV=development
# Leave MONGODB_URI empty or set your local / Atlas MongoDB connection string.
# If left empty or connection fails, an automatic in-memory MongoDB will be used.
MONGODB_URI=
JWT_SECRET=civictrack_super_secure_jwt_secret_key_2026_modern
JWT_EXPIRE=30d

# Cloudinary (Optional - if omitted, CivicTrack stores uploaded files locally in /uploads folder)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client URL for CORS
CLIENT_URL=http://localhost:3000
